          <button class="aw-btn" id="awAsk">Ask Wakili</button>
          <button class="aw-btn-ghost" id="awClear">Clear</button>
        </div>
        <div class="aw-chips" id="awChips"></div>
        <div class="aw-corpus-note"><span class="aw-live-dot"></span>Grounded in <strong>33 published case notes</strong> from our Case Digest — cites none it can't verify</div>
      </div>

