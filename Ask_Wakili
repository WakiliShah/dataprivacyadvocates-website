<script>
(function(){
  const EXAMPLES = [
    "A lender deducted my salary for a loan I never took",
    "A company won't let me correct my data",
    "My employer shared my data with a third party",
    "I want to challenge an ODPC determination",
    "A business used my photo without consent"
  ];

  const $ = (id) => document.getElementById(id);
  const queryEl = $('awQuery'), askBtn = $('awAsk'), clearBtn = $('awClear'), chipsEl = $('awChips');
  const loadingEl = $('awLoading'), errorEl = $('awError'), resultsEl = $('awResults');
  const issuePanel = $('awIssuePanel'), authPanel = $('awAuthPanel'), topicsPanel = $('awTopicsPanel');

  EXAMPLES.forEach(ex => {
    const c = document.createElement('button');
    c.type = 'button'; c.className = 'aw-chip'; c.textContent = ex;
    c.addEventListener('click', () => { queryEl.value = ex; runQuery(ex); });
    chipsEl.appendChild(c);
  });

  function esc(s){ const d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }

  async function runQuery(query){
    if (!query || query.trim().length < 4) return;
    errorEl.classList.remove('show');
    resultsEl.classList.remove('show');
    loadingEl.classList.add('show');
    askBtn.disabled = true;

    try {
      const res = await fetch('/api/ask-wakili', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: query.trim() })
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.message || data.error || 'request_failed');
      }
      render(data);
    } catch (err) {
      console.error('Ask Wakili error:', err);
      errorEl.textContent = (err && err.message && err.message !== 'request_failed')
        ? err.message
        : "Ask Wakili couldn't process that just now. Please try rephrasing, or contact the firm directly.";
      errorEl.classList.add('show');
    } finally {
      loadingEl.classList.remove('show');
      askBtn.disabled = false;
    }
  }

  function render(data){
    issuePanel.innerHTML = `
      <div class="aw-panel-head">
        <h3>${esc(data.issue_title)}</h3>
        <span class="aw-badge">Educational information</span>
      </div>
      <p>${esc(data.issue_summary)}</p>
      ${data.statutory_hooks && data.statutory_hooks.length ? `<div class="aw-hooks">${data.statutory_hooks.map(h => `<span class="aw-hook">${esc(h)}</span>`).join('')}</div>` : ''}
    `;

    if (data.no_match || !data.authorities || !data.authorities.length){
      authPanel.innerHTML = `
        <div class="aw-panel-head"><h3>Relevant case notes</h3></div>
        <p class="aw-nomatch">Nothing in our Case Digest is a close match for this yet. That doesn't mean the law is silent on it — it means this specific scenario isn't in our published notes. Our team can advise directly.</p>
      `;
    } else {
      authPanel.innerHTML = `
        <div class="aw-panel-head"><h3>Relevant case notes</h3></div>
        <div class="aw-auth-group">
        ${data.authorities.map(a => `
          <div class="aw-auth">
            <div class="aw-auth-top">
              <div>
                <div class="aw-auth-name">${esc(a.name)}</div>
                <div class="aw-auth-cite">${esc(a.citation)} · ${esc(a.outcome)}</div>
              </div>
              <span class="aw-rel ${a.relevance === 'Most relevant' ? 'aw-rel-most' : 'aw-rel-related'}">${esc(a.relevance)}</span>
            </div>
            <p class="aw-auth-why">${esc(a.why)}</p>
            <a class="aw-auth-link" href="${a.url}">Read the full case note →</a>
          </div>
        `).join('')}
        </div>
      `;
    }

    topicsPanel.innerHTML = `
      <div class="aw-panel-head"><h3 style="font-family:var(--font-body);font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);">Related topics</h3></div>
      <div class="aw-topics">${(data.related_topics || []).map(t => `<span class="aw-topic">${esc(t)}</span>`).join('')}</div>
      <div class="aw-cta">
        <span>General information only — not a substitute for advice on your specific facts.</span>
        <a href="#talk-to-counsel">Choose how to reach us ↓</a>
      </div>
    `;

    resultsEl.classList.add('show');
  }

  askBtn.addEventListener('click', () => runQuery(queryEl.value));
  queryEl.addEventListener('keypress', (e) => { if (e.key === 'Enter') runQuery(queryEl.value); });
  clearBtn.addEventListener('click', () => { queryEl.value = ''; resultsEl.classList.remove('show'); errorEl.classList.remove('show'); });
})();
</script>

